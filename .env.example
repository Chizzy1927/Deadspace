# Copy to .env (repo root) and adjust. Never commit .env.
# Shared by the API, Prisma CLI, integration tests, and Vite (VITE_* only).

# --- API ---
# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgresql://deadspace:deadspace@localhost:5433/deadspace
PORT=3001
# Optional, Prisma CLI only (migrate deploy, db:drift): a direct, non-pooled connection string. Needed
# only when DATABASE_URL is a pooled endpoint (production on Neon). The running API never reads it.
# DIRECT_DATABASE_URL=
# Integration tests use a separate *_test database (created + migrated automatically).
# Optional: defaults to DATABASE_URL with "_test" appended to the database name.
# TEST_DATABASE_URL=postgresql://deadspace:deadspace@localhost:5433/deadspace_test
# Optional: ISO timestamp to reproduce an exact `npm run db:seed` (default: next UTC midnight).
# SEED_ANCHOR=2026-06-02T00:00:00Z
# Browser origin allowed by CORS.
WEB_ORIGIN=http://localhost:5173

# Public-demo controls (production values: TRUST_PROXY=2 on Render, DEMO_LISTING_CREATION=false).
# TRUST_PROXY=0                  # reverse-proxy hops to trust for client IPs
# DEMO_LISTING_CREATION=true     # false refuses POST /truck-legs and /warehouse-spaces (403)
# WRITE_RATE_LIMIT_PER_HOUR=30   # creates per client IP per hour, separate budget per resource
# MAX_ROWS_PER_TABLE=5000        # refuse new rows (503) once a table is this large

# Geocoding: geoapify | mock (the seed always uses mock and never calls Geoapify)
GEOCODER=mock
GEOAPIFY_API_KEY=

# --- Web (exposed to the browser bundle; never put secrets in VITE_* vars) ---
VITE_API_URL=http://localhost:3001
