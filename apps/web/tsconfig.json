{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "declaration": false,
    // Resolve @deadspace/shared to its TypeScript source (Vite does the same via resolve.conditions).
    "customConditions": ["@deadspace/source"]
  },
  "include": ["src", "test", "vite.config.ts"]
}
